<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand Identity (03_DESIGN_SYSTEM.md) -->
    <Color x:Key="PrimaryBrandColor">#F97316</Color>
    <SolidColorBrush x:Key="PrimaryBrandBrush" Color="{StaticResource PrimaryBrandColor}" />

    <Color x:Key="BrandAccentHoverColor">#EA580C</Color>
    <SolidColorBrush x:Key="BrandAccentHoverBrush" Color="{StaticResource BrandAccentHoverColor}" />

    <!-- Core Dark Charcoal Surfaces -->
    <Color x:Key="BackgroundColor">#0F1115</Color>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />

    <Color x:Key="DarkBackgroundColor">#0A0C10</Color>
    <SolidColorBrush x:Key="DarkBackgroundBrush" Color="{StaticResource DarkBackgroundColor}" />

    <Color x:Key="Surface1Color">#151922</Color>
    <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1Color}" />

    <Color x:Key="Surface2Color">#1B212B</Color>
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />

    <Color x:Key="Surface3Color">#222A35</Color>
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />

    <!-- Borders -->
    <Color x:Key="BorderColor">#14FFFFFF</Color>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <Color x:Key="StrongBorderColor">#24FFFFFF</Color>
    <SolidColorBrush x:Key="StrongBorderBrush" Color="{StaticResource StrongBorderColor}" />

    <!-- Typography Text Brushes -->
    <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />

    <Color x:Key="TextSecondaryColor">#B8C0CC</Color>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />

    <Color x:Key="TextMutedColor">#7E8795</Color>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <Color x:Key="TextDisabledColor">#626A76</Color>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />

    <!-- Semantic Status Colors -->
    <Color x:Key="StatusSuccessColor">#22C55E</Color>
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="{StaticResource StatusSuccessColor}" />

    <Color x:Key="StatusWarningColor">#F59E0B</Color>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarningColor}" />

    <Color x:Key="StatusErrorColor">#EF4444</Color>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="{StaticResource StatusErrorColor}" />

    <Color x:Key="StatusInfoColor">#60A5FA</Color>
    <SolidColorBrush x:Key="StatusInfoBrush" Color="{StaticResource StatusInfoColor}" />

</ResourceDictionary>
