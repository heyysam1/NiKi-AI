<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typeface Family: Inter -->
    <FontFamily x:Key="PrimaryFontFamily">Segoe UI, Inter, sans-serif</FontFamily>

    <!-- Font Size Scale -->
    <sys:Double x:Key="FontSizeDisplay">32</sys:Double>
    <sys:Double x:Key="FontSizeH1">24</sys:Double>
    <sys:Double x:Key="FontSizeH2">18</sys:Double>
    <sys:Double x:Key="FontSizeH3">15</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeMicro">11</sys:Double>

</ResourceDictionary>
