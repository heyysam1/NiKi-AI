<Window x:Class="NikiAI.App.Views.ApprovalPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Niki AI - Permission Request"
        Width="460"
        Height="360"
        MinWidth="440"
        MinHeight="340"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource PrimaryFontFamily}">

    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- HEADER: Logo, Title, and Risk Badge -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource Surface2Brush}" Margin="0,0,10,0">
                        <TextBlock Text="🛡️" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Permission Request" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock x:Name="SubtitleText" Text="Niki requires approval for an action" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Risk Badge -->
                <Border x:Name="RiskBadgeBorder" Grid.Column="1" CornerRadius="4" Padding="8,3" VerticalAlignment="Center" Background="#22F59E0B">
                    <TextBlock x:Name="RiskBadgeText" Text="Sensitive" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource StatusWarningBrush}" />
                </Border>
            </Grid>

            <!-- CONTENT CARD: Action, Target Resource, Disclosure -->
            <Border Grid.Row="1" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="ActionDescriptionText" Text="Action details will appear here." TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Resource:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock x:Name="ResourceText" Grid.Column="1" Text="Unknown" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Reversible:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock x:Name="ReversibleText" Grid.Column="1" Text="No" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Grid>

                        <Grid x:Name="DisclosurePanel" Margin="0,0,0,6" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="External:" FontSize="12" Foreground="{StaticResource StatusWarningBrush}" />
                            <TextBlock x:Name="DisclosureText" Grid.Column="1" Text="" FontSize="11" Foreground="{StaticResource StatusWarningBrush}" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- COUNTDOWN / EXPIRATION NOTICE -->
            <Grid Grid.Row="2" Margin="0,0,0,14">
                <TextBlock x:Name="ExpirationText" Text="Request expires in 60s" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
            </Grid>

            <!-- BUTTONS: Deny, Allow Once, Always Allow -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="DenyButton" Grid.Column="0" Content="Deny" Height="36" Style="{StaticResource NikiSecondaryButtonStyle}" Click="DenyButton_Click" IsCancel="True" />
                <Button x:Name="AllowOnceButton" Grid.Column="2" Content="Allow Once" Height="36" Style="{StaticResource NikiSecondaryButtonStyle}" Click="AllowOnceButton_Click" />
                <Button x:Name="AlwaysAllowButton" Grid.Column="4" Content="Always Allow" Height="36" Style="{StaticResource NikiPrimaryButtonStyle}" Click="AlwaysAllowButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
