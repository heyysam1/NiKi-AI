<Window x:Class="NikiAI.App.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Niki AI - Assistant Workspace"
        Width="840"
        Height="640"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource PrimaryFontFamily}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. HEADER BAR -->
        <Border Grid.Row="0" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Assistant Info & Model -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#24F97316" Margin="0,0,12,0">
                        <TextBlock Text="✦" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Niki AI Assistant" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <!-- Online / Status Dot -->
                            <Border x:Name="BorderStatusDot" Width="8" Height="8" CornerRadius="4"
                                    Background="{StaticResource StatusSuccessBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TextConnectionStatus" Text="Ready" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="TextModelBadge" Text="Provider: OpenAI Compatible (gpt-4o-mini)" FontSize="10.5"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Main Application Workspace Navigation Bar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0">
                    <Button x:Name="NavButtonChat" Content="💬 Chat"
                            Style="{StaticResource NikiPrimaryButtonStyle}"
                            Height="28" Padding="10,0" FontSize="11.5" Margin="0,0,6,0"
                            Click="OnNavChatClick" />
                    <Button x:Name="NavButtonTasks" Content="📋 Tasks"
                            Style="{StaticResource NikiSecondaryButtonStyle}"
                            Height="28" Padding="10,0" FontSize="11.5" Margin="0,0,6,0"
                            Click="OnNavTasksClick" />
                    <Button x:Name="NavButtonMemory" Content="🧠 Memory"
                            Style="{StaticResource NikiSecondaryButtonStyle}"
                            Height="28" Padding="10,0" FontSize="11.5" Margin="0,0,6,0"
                            Click="OnNavMemoryClick" />
                    <Button x:Name="NavButtonWidgets" Content="🧩 Widgets"
                            Style="{StaticResource NikiSecondaryButtonStyle}"
                            Height="28" Padding="10,0" FontSize="11.5" Margin="0,0,6,0"
                            Click="OnNavWidgetsClick" />
                    <Button x:Name="NavButtonWorkflows" Content="⚡ Workflows"
                            Style="{StaticResource NikiSecondaryButtonStyle}"
                            Height="28" Padding="10,0" FontSize="11.5" Margin="0,0,6,0"
                            Click="OnNavWorkflowsClick" />
                </StackPanel>

                <!-- Action Controls (Settings, Clear, Close) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ButtonSettings" Content="⚙ Settings"
                            Style="{StaticResource NikiSecondaryButtonStyle}"
                            Height="30" Padding="12,2" FontSize="11" Margin="0,0,8,0"
                            Click="OnSettingsClick" />
                    <Button x:Name="ButtonClearChat" Content="Clear"
                            Style="{StaticResource NikiSecondaryButtonStyle}"
                            Height="30" Padding="10,2" FontSize="11" Margin="0,0,8,0"
                            Click="OnClearChatClick" />
                    <Button Content="Close"
                            Style="{StaticResource NikiSecondaryButtonStyle}"
                            Height="30" Padding="12,2" FontSize="11"
                            Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. CONVERSATION VIEW -->
        <Grid Grid.Row="1" Margin="16,12">
            <!-- Messages Scroll Area -->
            <ScrollViewer x:Name="ScrollViewerMessages" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PanelMessages" VerticalAlignment="Top">
                    <!-- Welcome Initial Message -->
                    <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,12" MaxWidth="680" HorizontalAlignment="Left">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Niki AI" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryBrandBrush}" />
                                <TextBlock Text="System Assistant" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Hello! I'm Niki, your Windows desktop AI companion. You can chat with me, ask questions, or assign background tasks while you work. How can I assist you today?"
                                       FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="19" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- SETTINGS DRAWER / OVERLAY -->
            <Grid x:Name="OverlaySettings" Background="#B3000000" Visibility="Collapsed">
                <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource StrongBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Padding="22">
                    <StackPanel>
                        <TextBlock Text="AI Provider Settings" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Configure your LLM endpoint. API keys are encrypted at rest using Windows DPAPI."
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,16" />

                        <!-- Endpoint URL -->
                        <TextBlock Text="Base Endpoint URL" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox x:Name="InputEndpointUrl" Text="https://api.openai.com/v1"
                                 Style="{StaticResource NikiTextBoxStyle}" Height="30" Margin="0,0,0,12" />

                        <!-- Model Name -->
                        <TextBlock Text="Model Name" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox x:Name="InputModelName" Text="gpt-4o-mini"
                                 Style="{StaticResource NikiTextBoxStyle}" Height="30" Margin="0,0,0,12" />

                        <!-- API Key -->
                        <TextBlock Text="API Key (Protected by Windows DPAPI)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <PasswordBox x:Name="InputApiKey" Background="{StaticResource Surface2Brush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                     Height="30" Padding="8,4" Margin="0,0,0,4" />
                        <TextBlock x:Name="TextMaskedKeyStatus" Text="Stored Key: (Not configured)"
                                   FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16" />

                        <!-- Connection Test Result Box -->
                        <Border x:Name="BorderTestResult" Background="{StaticResource Surface2Brush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="10" Margin="0,0,0,16" Visibility="Collapsed">
                            <TextBlock x:Name="TextTestResult" Text="Testing connection..."
                                       FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" />
                        </Border>

                        <!-- Application Lifecycle & Voice Settings (Phase 12) -->
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,12" Padding="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Application Lifecycle &amp; Voice" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                
                                <CheckBox x:Name="CheckBoxStartWithWindows" Content="Start Niki AI automatically with Windows"
                                          Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Close Window Action:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" x:Name="ComboBoxCloseBehavior" Width="170" Height="26"
                                              Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextPrimaryBrush}">
                                        <ComboBoxItem Content="Minimize to Tray" IsSelected="True" />
                                        <ComboBoxItem Content="Exit Application" />
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Desktop Pet Surface:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" x:Name="ButtonTogglePetVisibility" Content="Toggle Pet Show/Hide"
                                            Style="{StaticResource NikiSecondaryButtonStyle}" Height="26" Padding="10,0"
                                            Click="OnTogglePetVisibilityClick" />
                                </Grid>

                                <CheckBox x:Name="CheckBoxVoiceOutput" Content="Enable spoken audio response (TTS)"
                                          Foreground="{StaticResource TextPrimaryBrush}" IsChecked="True" Margin="0,0,0,8" />
                            </StackPanel>
                        </Border>

                        <!-- Actions -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" x:Name="ButtonTestConnection" Content="Test Connection"
                                    Style="{StaticResource NikiSecondaryButtonStyle}" Height="32" Padding="12,2"
                                    Click="OnTestConnectionClick" />

                            <Button Grid.Column="2" Content="Cancel"
                                    Style="{StaticResource NikiSecondaryButtonStyle}" Height="32" Padding="14,2" Margin="0,0,8,0"
                                    Click="OnCancelSettingsClick" />

                            <Button Grid.Column="3" Content="Save Settings"
                                    Style="{StaticResource NikiPrimaryButtonStyle}" Height="32" Padding="16,2"
                                    Click="OnSaveSettingsClick" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 3. INPUT COMPOSER -->
        <Border Grid.Row="2" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Input box + Send Button + Voice Button -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TextBoxPrompt"
                             Style="{StaticResource NikiTextBoxStyle}"
                             MinHeight="40" MaxHeight="100"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Padding="10,8" FontSize="13"
                             PreviewKeyDown="OnPromptPreviewKeyDown" />

                    <!-- Voice Push-to-Talk / Toggle Button (Phase 12) -->
                    <Button Grid.Column="1" x:Name="ButtonVoice" Content="🎤 Voice"
                            Style="{StaticResource NikiSecondaryButtonStyle}"
                            Height="38" Padding="12,0" FontSize="12" Margin="8,0,0,0"
                            Click="OnVoiceButtonClick" />

                    <!-- Send Button -->
                    <Button Grid.Column="2" x:Name="ButtonSend" Content="Send ↵"
                            Style="{StaticResource NikiPrimaryButtonStyle}"
                            Height="38" Padding="16,0" FontSize="12" Margin="6,0,0,0"
                            Click="OnSendClick" />

                    <!-- Cancel In-flight Button -->
                    <Button Grid.Column="3" x:Name="ButtonCancelGeneration" Content="Stop ■"
                            Style="{StaticResource NikiSecondaryButtonStyle}"
                            Height="38" Padding="12,0" FontSize="12" Margin="6,0,0,0"
                            Foreground="{StaticResource StatusErrorBrush}"
                            Visibility="Collapsed"
                            Click="OnCancelGenerationClick" />
                </Grid>

                <!-- Helper shortcuts label -->
                <TextBlock Grid.Row="1" Text="Press Enter to send, Shift+Enter for newline"
                           FontSize="10" Foreground="{StaticResource TextDisabledBrush}"
                           Margin="2,4,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
