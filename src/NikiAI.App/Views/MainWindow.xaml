<Window x:Class="NikiAI.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Niki AI — Desktop Assistant &amp; Autonomous Operator"
        Width="960"
        Height="700"
        MinWidth="800"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource PrimaryFontFamily}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto" />
            <!-- 1: Main Content Tabs -->
            <RowDefinition Height="*" />
            <!-- 2: Status Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER BAR -->
        <Border Grid.Row="0" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand / Logo / Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="10" Background="#24F97316" Margin="0,0,12,0">
                        <TextBlock Text="✦" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Niki AI" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Border x:Name="BorderConnectionStatus" Width="8" Height="8" CornerRadius="4"
                                    Background="{StaticResource StatusSuccessBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TextConnectionStatus" Text="Connected" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="TextProviderSubtitle" Text="Autonomous Desktop AI Operator" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0">
                    <Button x:Name="NavButtonChat" Content="💬 Operator"
                            Style="{StaticResource NikiPrimaryButtonStyle}"
                            Height="30" Padding="12,0" FontSize="12" Margin="0,0,6,0"
                            Click="OnNavChatClick" />
                    <Button x:Name="NavButtonTasks" Content="📋 Tasks"
                            Style="{StaticResource NikiSecondaryButtonStyle}"
                            Height="30" Padding="12,0" FontSize="12" Margin="0,0,6,0"
                            Click="OnNavTasksClick" />
                    <Button x:Name="NavButtonWorkflows" Content="⚡ Workflows"
                            Style="{StaticResource NikiSecondaryButtonStyle}"
                            Height="30" Padding="12,0" FontSize="12" Margin="0,0,6,0"
                            Click="OnNavWorkflowsClick" />
                    <Button x:Name="NavButtonMemory" Content="🧠 Memory"
                            Style="{StaticResource NikiSecondaryButtonStyle}"
                            Height="30" Padding="12,0" FontSize="12" Margin="0,0,6,0"
                            Click="OnNavMemoryClick" />
                    <Button x:Name="NavButtonSettings" Content="⚙ Settings"
                            Style="{StaticResource NikiSecondaryButtonStyle}"
                            Height="30" Padding="12,0" FontSize="12" Margin="0,0,6,0"
                            Click="OnNavSettingsClick" />
                </StackPanel>

                <!-- Desktop Pet Companion Toggle -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ButtonTogglePet" Content="🐾 Desktop Pet"
                            Style="{StaticResource NikiSecondaryButtonStyle}"
                            Height="30" Padding="12,0" FontSize="11.5"
                            Click="OnTogglePetClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="1">
            <!-- TAB 1: OPERATOR & CHAT -->
            <Grid x:Name="ViewOperator" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Message History -->
                <ScrollViewer x:Name="ScrollMessages" Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="20,16">
                    <StackPanel x:Name="PanelMessages" VerticalAlignment="Top">
                        <!-- Welcome Card -->
                        <Border Style="{StaticResource NikiCardStyle}" Margin="0,0,0,16" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Welcome to Niki AI Operator" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="Direct conversational orchestration with native tool-calling, self-correction, and background task execution. Type a command or question below to start."
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Input Dock -->
                <Border Grid.Row="1" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0" Padding="18,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Input Text Box -->
                        <TextBox x:Name="InputPrompt" Grid.Row="0" Grid.Column="0"
                                 Style="{StaticResource NikiTextBoxStyle}"
                                 Height="38" Padding="10,8" FontSize="12.5"
                                 KeyDown="OnInputPromptKeyDown" />

                        <!-- Voice Mic Button -->
                        <Button x:Name="ButtonVoice" Grid.Row="0" Grid.Column="1" Content="🎤"
                                Style="{StaticResource NikiSecondaryButtonStyle}"
                                Width="38" Height="38" Margin="8,0,0,0" FontSize="14"
                                Click="OnVoiceClick" ToolTip="Voice Command (Push to Talk)" />

                        <!-- Send Button -->
                        <Button x:Name="ButtonSend" Grid.Row="0" Grid.Column="2" Content="Send"
                                Style="{StaticResource NikiPrimaryButtonStyle}"
                                Height="38" Padding="18,0" Margin="8,0,0,0" FontSize="12.5"
                                Click="OnSendClick" />

                        <!-- Options Row -->
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,0">
                            <CheckBox x:Name="CheckTrackTask" Content="Track as Durable Task"
                                      Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <TextBlock x:Name="TextBusyIndicator" Text="Processing request..."
                                       Foreground="{StaticResource PrimaryBrandBrush}" FontSize="11" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- TAB 2: TASKS -->
            <Grid x:Name="ViewTasks" Visibility="Collapsed" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Text="Tasks &amp; Operations" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Button Content="Refresh" Style="{StaticResource NikiSecondaryButtonStyle}" Height="28" Padding="10,0" FontSize="11" Margin="16,0,0,0" Click="OnRefreshTasksClick" />
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource NikiCardStyle}" Padding="0">
                    <ListView x:Name="ListTasks" Background="Transparent" BorderThickness="0"
                              Foreground="{StaticResource TextPrimaryBrush}" SelectionChanged="OnTaskSelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding NaturalLanguageRequest}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="6" Background="#22FFFFFF" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>

            <!-- TAB 3: WORKFLOWS -->
            <Grid x:Name="ViewWorkflows" Visibility="Collapsed" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Text="Multi-Step Workflows" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Button Content="Refresh" Style="{StaticResource NikiSecondaryButtonStyle}" Height="28" Padding="10,0" FontSize="11" Margin="16,0,0,0" Click="OnRefreshWorkflowsClick" />
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource NikiCardStyle}" Padding="0">
                    <ListView x:Name="ListWorkflows" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Run" Tag="{Binding Id}"
                                                Style="{StaticResource NikiPrimaryButtonStyle}" Height="28" Padding="12,0" FontSize="11"
                                                VerticalAlignment="Center" Click="OnRunWorkflowClick" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>

            <!-- TAB 4: MEMORY -->
            <Grid x:Name="ViewMemory" Visibility="Collapsed" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Explicit User Memory &amp; Knowledge" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14" />

                <!-- Add Memory Input -->
                <Border Grid.Row="1" Style="{StaticResource NikiCardStyle}" Margin="0,0,0,14" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InputMemoryContent" Grid.Column="0"
                                 Style="{StaticResource NikiTextBoxStyle}"
                                 Height="34" Padding="10,6" FontSize="12" />
                        <Button Grid.Column="1" Content="Save Memory"
                                Style="{StaticResource NikiPrimaryButtonStyle}"
                                Height="34" Padding="14,0" Margin="8,0,0,0" FontSize="11.5"
                                Click="OnSaveMemoryClick" />
                    </Grid>
                </Border>

                <!-- Memories List -->
                <Border Grid.Row="2" Style="{StaticResource NikiCardStyle}" Padding="0">
                    <ListView x:Name="ListMemories" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Content}" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                        <Button Grid.Column="1" Content="Delete" Tag="{Binding Id}"
                                                Style="{StaticResource NikiSecondaryButtonStyle}" Height="24" Padding="8,0" FontSize="10.5"
                                                VerticalAlignment="Center" Click="OnDeleteMemoryClick" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>

            <!-- TAB 5: SETTINGS -->
            <ScrollViewer x:Name="ViewSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                    <TextBlock Text="AI Provider &amp; Model Configuration" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                    <!-- Endpoint -->
                    <TextBlock Text="Endpoint URL" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox x:Name="InputEndpointUrl" Style="{StaticResource NikiTextBoxStyle}" Height="34" Padding="10,6" FontSize="12" Margin="0,0,0,14" />

                    <!-- Model Name -->
                    <TextBlock Text="Model Name" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox x:Name="InputModelName" Style="{StaticResource NikiTextBoxStyle}" Height="34" Padding="10,6" FontSize="12" Margin="0,0,0,14" />

                    <!-- API Key -->
                    <TextBlock Text="API Key (Encrypted via Windows DPAPI)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <PasswordBox x:Name="InputApiKey" Height="34" Padding="10,6" FontSize="12" Margin="0,0,0,14"
                                 Background="{StaticResource Surface1Brush}" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,24">
                        <Button Content="Save Settings" Style="{StaticResource NikiPrimaryButtonStyle}" Height="34" Padding="16,0" FontSize="12" Click="OnSaveSettingsClick" Margin="0,0,10,0" />
                        <Button Content="Test Connection" Style="{StaticResource NikiSecondaryButtonStyle}" Height="34" Padding="16,0" FontSize="12" Click="OnTestConnectionClick" />
                    </StackPanel>

                    <TextBlock x:Name="TextSettingsFeedback" FontSize="12" Foreground="{StaticResource StatusSuccessBrush}" Margin="0,0,0,20" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- STATUS FOOTER -->
        <Border Grid.Row="2" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="18,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TextFooterStatus" Text="Niki AI Ready" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Desktop Pet Status: Active" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
