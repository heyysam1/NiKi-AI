<Window x:Class="NikiAI.App.Views.ResultPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Niki AI - Notification"
        Width="380"
        Height="270"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        FontFamily="{StaticResource PrimaryFontFamily}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.Resources>
        <DropShadowEffect x:Key="PopupShadow" BlurRadius="22" Direction="270" ShadowDepth="4" Opacity="0.55" Color="#000000" />
    </Window.Resources>

    <Border Background="{StaticResource Surface1Brush}"
            BorderBrush="{StaticResource StrongBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="16"
            Margin="10"
            Effect="{StaticResource PopupShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- HEADER: Logo, Title, State Pill, and Close Button -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Avatar / Logo -->
                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="{StaticResource Surface2Brush}" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Image x:Name="AvatarImage" Source="/Assets/niki Logo.png" Stretch="Uniform" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Title & Timestamp -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="NotificationTitleText" Text="Task Completed" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TimestampText" Text="Just now" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>

                <!-- State Badge -->
                <Border x:Name="StateBadgeBorder" Grid.Column="2" CornerRadius="10" Padding="8,2" Margin="0,0,8,0" VerticalAlignment="Center" Background="#2222C55E">
                    <TextBlock x:Name="StateBadgeText" Text="Success" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource StatusSuccessBrush}" />
                </Border>

                <!-- Dismiss Icon Button -->
                <Button Grid.Column="3" Click="OnDismissClicked" Background="Transparent" BorderThickness="0" Cursor="Hand" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="✕" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                </Button>
            </Grid>

            <!-- CONTENT CARD: Summary and Key Outputs -->
            <Border Grid.Row="1" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- One-Sentence Summary -->
                        <TextBlock x:Name="SummaryText" Text="Task summary content here." FontWeight="Medium" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />

                        <!-- Key Outputs List -->
                        <ItemsControl x:Name="KeyOutputsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="•" FontSize="11" Foreground="{StaticResource PrimaryBrandBrush}" VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ACTION BUTTONS: View Results, Open Artifact, Snooze, Dismiss -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status / Associated Task Info -->
                <TextBlock x:Name="TaskIdText" Grid.Column="0" Text="" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />

                <!-- Open Artifact Button -->
                <Button x:Name="OpenArtifactButton" Grid.Column="1" Click="OnOpenArtifactClicked" Visibility="Collapsed"
                        Content="Open Artifact" Height="28" Padding="10,0" Margin="0,0,6,0"
                        Background="{StaticResource Surface3Brush}" Foreground="{StaticResource TextPrimaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" FontSize="11" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- Snooze Button (for reminders) -->
                <Button x:Name="SnoozeButton" Grid.Column="2" Click="OnSnoozeClicked" Visibility="Collapsed"
                        Content="Snooze 5m" Height="28" Padding="10,0" Margin="0,0,6,0"
                        Background="{StaticResource Surface3Brush}" Foreground="{StaticResource TextSecondaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" FontSize="11" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- View Results / Primary Action Button -->
                <Button x:Name="ViewResultsButton" Grid.Column="3" Click="OnViewResultsClicked"
                        Content="View Results" Height="28" Padding="12,0"
                        Background="{StaticResource PrimaryBrandBrush}" Foreground="#FFFFFF"
                        BorderThickness="0" FontWeight="SemiBold" FontSize="11" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
