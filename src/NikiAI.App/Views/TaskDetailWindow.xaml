<Window x:Class="NikiAI.App.Views.TaskDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Niki AI - Tasks &amp; History"
        Width="880"
        Height="600"
        MinWidth="760"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource PrimaryFontFamily}">

    <Window.Resources>
        <!-- Status Badge Style -->
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Main 2-Column Master-Detail Layout -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="260" MaxWidth="440" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" MinWidth="400" />
        </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN: Task List & Filtering -->
        <Border Grid.Column="0" Background="{StaticResource Surface1Brush}" Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header + New Task Button -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Tasks &amp; History" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock x:Name="TextTaskCount" Text="0 tasks total" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1" x:Name="ButtonNewTask" Content="+ New Task"
                            Style="{StaticResource NikiPrimaryButtonStyle}"
                            Height="32" Padding="12,4" FontSize="12"
                            Click="OnNewTaskClick" />
                </Grid>

                <!-- Search Box -->
                <Border Grid.Row="1" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,0,0,8">
                    <Grid>
                        <TextBox x:Name="TextBoxSearch" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="{StaticResource PrimaryBrandBrush}"
                                 FontSize="12" VerticalAlignment="Center"
                                 TextChanged="OnSearchTextChanged" />
                        <TextBlock x:Name="TextSearchPlaceholder" Text="Search tasks by title or ID..."
                                   Foreground="{StaticResource TextDisabledBrush}" FontSize="12"
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="Visible" />
                    </Grid>
                </Border>

                <!-- Filter Row -->
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" x:Name="ComboBoxStatusFilter"
                              Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextPrimaryBrush}"
                              BorderBrush="{StaticResource BorderBrush}" Height="28" FontSize="11"
                              SelectionChanged="OnFilterChanged">
                        <ComboBoxItem Content="All Statuses" IsSelected="True" />
                        <ComboBoxItem Content="Created" />
                        <ComboBoxItem Content="Planning" />
                        <ComboBoxItem Content="Running" />
                        <ComboBoxItem Content="Paused" />
                        <ComboBoxItem Content="AwaitingInput" />
                        <ComboBoxItem Content="Completed" />
                        <ComboBoxItem Content="Failed" />
                        <ComboBoxItem Content="Cancelled" />
                    </ComboBox>

                    <CheckBox Grid.Column="1" x:Name="CheckBoxShowArchived" Content="Archived"
                              Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                              VerticalAlignment="Center" Margin="8,0,0,0"
                              Checked="OnShowArchivedChecked" Unchecked="OnShowArchivedChecked" />
                </Grid>

                <!-- Task List View -->
                <ListBox Grid.Row="3" x:Name="ListBoxTasks"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnTaskSelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                            <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Surface3Brush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A1F18" />
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrandBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- SPLITTER / BORDER -->
        <Rectangle Grid.Column="1" Fill="{StaticResource BorderBrush}" />

        <!-- RIGHT COLUMN: Task Details & Audit Events -->
        <Grid Grid.Column="2" Margin="20,16">
            <!-- Empty Selection State -->
            <Grid x:Name="GridEmptyState" Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="No Task Selected" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Select a task from the list or click '+ New Task' to begin."
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,4,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Task Detail View Panel -->
            <Grid x:Name="GridDetailPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. Header: Title, Status Badge, Priority -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="TextDetailTitle" Text="Task Title"
                                   FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Border x:Name="BorderDetailStatusBadge" Style="{StaticResource StatusBadgeStyle}" Background="{StaticResource Surface3Brush}">
                                <TextBlock x:Name="TextDetailStatus" Text="Running" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrandBrush}" />
                            </Border>
                            <Border x:Name="BorderDetailPriorityBadge" Style="{StaticResource StatusBadgeStyle}" Background="{StaticResource Surface3Brush}" Margin="8,0,0,0">
                                <TextBlock x:Name="TextDetailPriority" Text="Normal" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                            <Border x:Name="BorderDetailArchivedBadge" Style="{StaticResource StatusBadgeStyle}" Background="#3A1515" Margin="8,0,0,0" Visibility="Collapsed">
                                <TextBlock Text="Archived" FontSize="11" Foreground="{StaticResource StatusErrorBrush}" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- ID and Timestamps -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBlock x:Name="TextDetailTaskId" Text="ID: #000000" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                        <TextBlock x:Name="TextDetailCreated" Text="Created: -" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                        <TextBlock x:Name="TextDetailUpdated" Text="Updated: -" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <!-- 2. Truthful Progress & Stage Section -->
                <Border Grid.Row="1" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Progress &amp; Execution Stage" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock x:Name="TextTruthfulProgressPercent" Text="75%" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrandBrush}" HorizontalAlignment="Right" />
                        </Grid>

                        <!-- Progress bar (Visible only if ProgressPercentage has a measurable value) -->
                        <ProgressBar x:Name="ProgressBarTask" Height="6" Margin="0,8,0,4"
                                     Foreground="{StaticResource PrimaryBrandBrush}" Background="{StaticResource Surface3Brush}"
                                     BorderThickness="0" Minimum="0" Maximum="100" />

                        <!-- Stage indicator & Truthful note -->
                        <TextBlock x:Name="TextDetailStage" Text="Stage: Execution" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <!-- 3. Description Section -->
                <Border Grid.Row="2" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Description" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBlock x:Name="TextDetailDescription" Text="No description provided."
                                   FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" MaxHeight="80" />
                    </StackPanel>
                </Border>

                <!-- 4. Audit History & Event Timeline -->
                <Border Grid.Row="3" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="Audit History &amp; Timeline" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock x:Name="TextEventCount" Text="0 events recorded" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <ListBox Grid.Row="1" x:Name="ListBoxAuditEvents"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="6,4" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                    <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- 5. Action Controls (Cancel, Archive, Close) -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="ButtonCancelTask" Content="Cancel Task"
                            Background="{StaticResource Surface3Brush}" Foreground="{StaticResource StatusErrorBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Height="32" Padding="14,4" FontSize="11" FontWeight="SemiBold"
                            Click="OnCancelTaskClick" />

                    <Button Grid.Column="1" x:Name="ButtonArchiveTask" Content="Archive (Soft Delete)"
                            Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextSecondaryBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Height="32" Padding="14,4" FontSize="11" Margin="8,0,0,0"
                            Click="OnArchiveTaskClick" />

                    <Button Grid.Column="3" Content="Close Window"
                            Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextPrimaryBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Height="32" Padding="16,4" FontSize="11"
                            Click="OnCloseWindowClick" />
                </Grid>
            </Grid>
        </Grid>

        <!-- MODAL OVERLAY: New Task Form (Creates REAL user tasks only) -->
        <Grid x:Name="OverlayNewTask" Grid.ColumnSpan="3" Background="#99000000" Visibility="Collapsed">
            <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource StrongBorderBrush}"
                    BorderThickness="1" CornerRadius="12" Width="460" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Create New Task" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Creates a real user task in local SQLite storage with audit history."
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,16" />

                    <!-- Title Input -->
                    <TextBlock Text="Task Title *" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox x:Name="InputNewTaskTitle"
                             Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}" CaretBrush="{StaticResource PrimaryBrandBrush}"
                             Height="30" FontSize="12" Padding="6,4" Margin="0,0,0,12" />

                    <!-- Stage Input -->
                    <TextBlock Text="Initial Stage (optional)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox x:Name="InputNewTaskStage" Text="Created"
                             Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}" CaretBrush="{StaticResource PrimaryBrandBrush}"
                             Height="30" FontSize="12" Padding="6,4" Margin="0,0,0,12" />

                    <!-- Description Input -->
                    <TextBlock Text="Description (optional)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox x:Name="InputNewTaskDescription" AcceptsReturn="True" TextWrapping="Wrap"
                             Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}" CaretBrush="{StaticResource PrimaryBrandBrush}"
                             Height="80" FontSize="12" Padding="6,4" Margin="0,0,0,16" />

                    <!-- Modal Actions -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1" Content="Cancel"
                                Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextSecondaryBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Height="32" Padding="14,4" FontSize="11" Margin="0,0,8,0"
                                Click="OnCancelNewTaskModalClick" />

                        <Button Grid.Column="2" Content="Create Task"
                                Style="{StaticResource NikiPrimaryButtonStyle}"
                                Height="32" Padding="18,4" FontSize="11"
                                Click="OnSubmitNewTaskModalClick" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
