<Window x:Class="NikiAI.App.Views.WorkflowEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Niki AI - Workflow Manager &amp; Editor"
        Width="920"
        Height="620"
        MinWidth="780"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="True"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource PrimaryFontFamily}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource Surface2Brush}" Margin="0,0,12,0">
                    <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Workflows &amp; Task Lifecycle" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Automated action chains governed by strict PermissionEngine security and non-sensitive signals." FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="RefreshButton" Content="Refresh" Margin="0,0,8,0" Padding="12,6" Click="OnRefreshClicked" />
                <Button x:Name="RunWorkflowButton" Content="▶ Run Workflow" FontWeight="Bold" Background="{StaticResource AccentBrush}" Foreground="White" Padding="14,6" Click="OnRunWorkflowClicked" />
            </StackPanel>
        </Grid>

        <!-- MAIN SPLIT: WORKFLOWS LIST & DETAIL -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: WORKFLOW LIST -->
            <Border Grid.Column="0" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Available Workflows" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" Foreground="{StaticResource TextPrimaryBrush}" />
                    <ListBox x:Name="WorkflowsListBox" Background="Transparent" BorderThickness="0" SelectionChanged="OnWorkflowSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,2" Padding="8,6" CornerRadius="6" Background="{StaticResource Surface2Brush}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <DockPanel Margin="0,4,0,0">
                                            <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding Trigger}" HorizontalAlignment="Right" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

            <!-- RIGHT: WORKFLOW DETAILS & ACTIONS -->
            <Border Grid.Column="2" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- WORKFLOW SUMMARY -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock x:Name="SelectedWorkflowName" Text="Select a workflow" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock x:Name="SelectedWorkflowDescription" Text="" Margin="0,4,0,8" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />

                        <WrapPanel Margin="0,4,0,0">
                            <TextBlock Text="Trigger: " FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock x:Name="TriggerTypeText" Text="Manual" FontWeight="Bold" FontSize="11" Margin="0,0,16,0" Foreground="{StaticResource TextPrimaryBrush}" />

                            <TextBlock Text="Timeout: " FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock x:Name="TimeoutText" Text="60s" FontWeight="Bold" FontSize="11" Margin="0,0,16,0" Foreground="{StaticResource TextPrimaryBrush}" />

                            <TextBlock Text="Completion: " FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock x:Name="CompletionText" Text="Notify" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- ACTION SEQUENCE -->
                    <DockPanel Grid.Row="1">
                        <TextBlock DockPanel.Dock="Top" Text="Configured Actions (Sequential)" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" Foreground="{StaticResource TextPrimaryBrush}" />
                        <ListView x:Name="ActionsListView" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Step" Width="45" DisplayMemberBinding="{Binding StepNumber}" />
                                    <GridViewColumn Header="Action Name" Width="170" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="Type" Width="90" DisplayMemberBinding="{Binding ActionType}" />
                                    <GridViewColumn Header="Tool ID" Width="120" DisplayMemberBinding="{Binding ToolId}" />
                                    <GridViewColumn Header="Approval" Width="80" DisplayMemberBinding="{Binding ApprovalRequiredText}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>

                    <!-- RUN MONITOR / STATUS BAR -->
                    <Border Grid.Row="2" Background="{StaticResource Surface2Brush}" CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Execution Status: " FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock x:Name="ExecutionStatusText" Text="Ready" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="ExecutionDetailsText" Grid.Column="1" Text="" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Security Note: Workflows pass all tool calls through IToolExecutor and PermissionEngine. Tool actions have no automatic retry in Phase 13." FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
        </Border>
    </Grid>
</Window>
