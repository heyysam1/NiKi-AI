<UserControl x:Class="NikiAI.Widgets.Controls.WidgetCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:widgets="clr-namespace:NikiAI.Widgets"
             xmlns:core="clr-namespace:NikiAI.Core.Widgets;assembly=NikiAI.Core"
             mc:Ignorable="d" 
             d:DesignHeight="140" d:DesignWidth="240">

    <UserControl.Resources>
        <SolidColorBrush x:Key="BrandOrange" Color="#F97316" />
        <SolidColorBrush x:Key="BrandOrangeHover" Color="#EA580C" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextSecondary" Color="#B8C0CC" />
        <SolidColorBrush x:Key="TextMuted" Color="#7E8795" />
        <SolidColorBrush x:Key="StatusError" Color="#EF4444" />
        <SolidColorBrush x:Key="CardGlassBg" Color="#D9151922" />
        <SolidColorBrush x:Key="CardSolidBg" Color="#151922" />
        <SolidColorBrush x:Key="CardMinimalBg" Color="#0A0C10" />
        <SolidColorBrush x:Key="CardBorder" Color="#24FFFFFF" />

        <Style x:Key="WidgetActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource BrandOrange}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrandOrangeHover}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="CardBorderContainer"
            CornerRadius="12"
            BorderThickness="1"
            BorderBrush="{StaticResource CardBorder}"
            Background="{StaticResource CardGlassBg}"
            Margin="6"
            Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: Icon, Title, Category Badge -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="IconBlock"
                           Text="{Binding IconGlyph, FallbackValue='❖'}"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />

                <TextBlock Grid.Column="1"
                           Text="{Binding Title, FallbackValue='Widget'}"
                           Foreground="{StaticResource TextPrimary}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />

                <Border Grid.Column="2"
                        Background="#1AFFFFFF"
                        CornerRadius="4"
                        Padding="5,1">
                    <TextBlock Text="{Binding Category, FallbackValue='System'}"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="10" />
                </Border>
            </Grid>

            <!-- Body: Primary and Secondary Value -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,4,0,8">
                <TextBlock Text="{Binding PrimaryDisplayValue, FallbackValue='--'}"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="16"
                           FontWeight="Bold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding SecondaryDisplayValue, FallbackValue=''}"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="11"
                           Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" />

                <!-- Error Indicator if any -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource StatusError}"
                           FontSize="10"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,2,0,0"
                           Visibility="{Binding HasError, Converter={x:Null}}" />
            </StackPanel>

            <!-- Footer: Action Button -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding PresentationState}"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="10"
                           VerticalAlignment="Center"
                           Opacity="0.7" />

                <Button Grid.Column="1"
                        Style="{StaticResource WidgetActionButtonStyle}"
                        Content="{Binding ActionLabel, FallbackValue='Action'}"
                        IsEnabled="{Binding IsActionEnabled}"
                        Click="OnActionButtonClick" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
