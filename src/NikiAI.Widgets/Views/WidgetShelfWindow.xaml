<Window x:Class="NikiAI.Widgets.Views.WidgetShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:NikiAI.Widgets.Controls"
        mc:Ignorable="d"
        Title="Niki AI — Widget Shelf"
        Height="540" Width="780"
        MinHeight="400" MinWidth="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <SolidColorBrush x:Key="ShelfBg" Color="#EA0F1115" />
        <SolidColorBrush x:Key="ShelfBorder" Color="#24FFFFFF" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextMuted" Color="#7E8795" />
        <SolidColorBrush x:Key="BrandOrange" Color="#F97316" />

        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#24FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource ShelfBg}"
            BorderBrush="{StaticResource ShelfBorder}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Window Header / Titlebar -->
            <Grid Grid.Row="0" Margin="0,0,0,12" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="❖" Foreground="{StaticResource BrandOrange}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Niki AI — Widget Shelf" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Surface Variant Switcher -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Surface:" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="VariantSelector"
                              Width="90" Height="24"
                              FontSize="11"
                              Background="#1AFFFFFF"
                              Foreground="{StaticResource TextPrimary}"
                              SelectionChanged="OnVariantSelectorSelectionChanged">
                        <ComboBoxItem Content="Glass" IsSelected="True" />
                        <ComboBoxItem Content="Solid" />
                        <ComboBoxItem Content="Minimal" />
                    </ComboBox>
                </StackPanel>

                <!-- Close / Hide Button -->
                <Button Grid.Column="3"
                        Style="{StaticResource WindowControlButton}"
                        Content="✕"
                        Click="OnCloseButtonClick" />
            </Grid>

            <!-- Scrollable Grid of Widgets -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="WidgetsItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemWidth="236" ItemHeight="136" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:WidgetCard DataContext="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
